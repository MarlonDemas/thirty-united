    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.61",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
