    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/fiber": "^9.8.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.1",
    "nodemailer": "^10.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
