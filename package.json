{
  "name": "thirty-united",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --workers=3",
    "budget": "node scripts/check-entry-budget.mjs",
    "og": "node scripts/render-og.mjs public/og.jpg",
    "capture": "node scripts/capture.mjs",
    "smoke": "node scripts/smoke.mjs",
    "rsvps:reset-limits": "convex run admin:resetCodeLimits",
    "rsvps:summary": "convex run admin:summary",
    "rsvps:get": "convex run admin:getGuest",
    "rsvps:delete": "convex run admin:deleteGuest",
    "rsvps:csv": "convex run admin:listRsvps | node scripts/export-rsvps.mjs"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "convex": "^1.46.0",
    "n8ao": "^2.0.1",
    "nodemailer": "^10.1.0",
    "postprocessing": "^6.39.6",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "convex-test": "^0.0.61",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
